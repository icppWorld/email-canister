[
  {
    match: '.well-known',
    ignore: false,
  },
  {
    match: '.well-known/*',
    ignore: false,
    headers: { 'Access-Control-Allow-Origin': '*' },
  },
  {
    // Internet Identity reads this as JSON, from the derivation origin; only a
    // deployment with a custom domain has it
    match: '.well-known/ii-alternative-origins',
    headers: { 'Content-Type': 'application/json' },
  },
  {
    // connect-src: on a canister's icp0.io address the agent sends API calls to
    // https://icp0.io itself, and on a custom domain to the page's own origin.
    // style-src allows inline style for the sandboxed message frames, which
    // inherit this policy; everything they can load is limited further there.
    // img-src allows https: for the same frames: their own policy blocks remote
    // images until the reader's Show images, for that message only.
    // font-src serves the brand's own font files.
    // frame-src: a link clicked in a message may not load its page in the
    // message's frame, which the sandbox alone would allow.
    // Cross-Origin-Opener-Policy: a page that opens the webmail keeps no
    // handle on it, to count its frames or steer its address; the sign-in
    // window the webmail opens itself keeps working.
    match: '**/*',
    security_policy: 'hardened',
    disable_security_policy_warning: true,
    headers: {
      'Content-Security-Policy': "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://icp0.io; frame-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      'Referrer-Policy': 'no-referrer',
      'Cross-Origin-Opener-Policy': 'same-origin-allow-popups',
      'X-Content-Type-Options': 'nosniff',
      'Permissions-Policy': 'camera=(), microphone=(), geolocation=(), payment=()',
    },
  },
  {
    // The page names the build's scripts and styles, so a browser checks for
    // a new one each time it loads: after a deploy, a reload shows the new
    // webmail instead of a copy the browser kept
    match: 'index.html',
    headers: { 'Cache-Control': 'no-cache' },
  },
  {
    // The brand's files keep their names when a deployment changes its brand
    match: 'brand.css',
    headers: { 'Cache-Control': 'no-cache' },
  },
  {
    match: 'brand/**/*',
    headers: { 'Cache-Control': 'no-cache' },
  },
  {
    // Their names carry a hash of their content, so a new build never
    // reuses one: kept for good. Only the build writes here; brand.mjs
    // writes its files beside them, never in assets/
    match: 'assets/**/*',
    headers: { 'Cache-Control': 'public, max-age=31536000, immutable' },
  },
]
